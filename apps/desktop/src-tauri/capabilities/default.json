{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: Tower commands, events, folder picker, native confirmation sheets and opening links.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:menu:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-ask",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/*" }, { "url": "https://*/pull/*" }, { "url": "https://*/merge_requests/*" }]
    },
    "opener:allow-open-path",
    "opener:allow-reveal-item-in-dir"
  ]
}
